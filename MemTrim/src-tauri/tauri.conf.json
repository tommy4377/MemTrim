{
  "productName": "MemTrim",
  "version": "1.0.2",
  "identifier": "com.tommy4377.memtrim",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MemTrim",
        "width": 500,
        "height": 700,
        "minWidth": 390,
        "minHeight": 190,
        "maxWidth": 500,
        "maxHeight": 700,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*",
      "devCsp": null,
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "tommy4377",
    "copyright": "© 2025-2026 tommy4377",
    "category": "Utility",
    "shortDescription": "Portable Windows memory optimization utility",
    "longDescription": "MemTrim is a portable Windows memory optimization utility."
  },
  "plugins": {}
}
